# Smart Campus Backend - Environment Template
# Copy to .env and fill values.
# Never commit real secrets.

# -----------------------------
# Server
# -----------------------------
NODE_ENV=development
PORT=3001
USE_MEMORY_DB=false
USE_MOCK_DB=false
MONGO_URI=mongodb://localhost:27017/smart-campus
JWT_SECRET=your-secret-key-here

# -----------------------------
# CORS
# -----------------------------
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=

# -----------------------------
# Auto Seed Configuration
# -----------------------------
AUTO_SEED_TEST_DATA=true
AUTO_SEED_RESET_DATA=false
SEED_TEST_PASSWORD=123456
FORCE_SEED_IN_PRODUCTION=false

# -----------------------------
# Super Admin Configuration
# -----------------------------
SUPER_ADMIN_EMAIL=admin@demo.com
SUPER_ADMIN_PASSWORD=123456
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+1234567890

# -----------------------------
# Email Configuration
# -----------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-password
EMAIL_FROM=noreply@smartcampus.com

# -----------------------------
# Cloudinary Configuration (for image uploads)
# -----------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------
# SMS Configuration
# -----------------------------
TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# -----------------------------
# Security
# -----------------------------
ENFORCE_HTTPS=false
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
MAX_FILE_SIZE=10485760

# -----------------------------
# Logging
# -----------------------------
LOG_LEVEL=info
LOG_TO_FILE=false
LOG_FILE_PATH=logs/app.log
