# Smart Campus Backend - Environment Template
# Copy to .env and fill values.
# Never commit real secrets.

# -----------------------------
# Server
# -----------------------------
NODE_ENV=development
PORT=3001

# -----------------------------
# Database (required unless USE_MEMORY_DB/USE_MOCK_DB=true)
# -----------------------------
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
# For local development only:
USE_MEMORY_DB=false
USE_MOCK_DB=false
MEMORY_DB_NAME=smart-campus-dev

# -----------------------------
# Auth / Security (required)
# -----------------------------
JWT_SECRET=replace_with_min_32_characters
JWT_REFRESH_SECRET=replace_with_min_32_characters
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d
BCRYPT_ROUNDS=12
SESSION_SECRET=replace_with_random_secret

# -----------------------------
# Super Admin (required)
# -----------------------------
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace_with_strong_password
SUPER_ADMIN_NAME=Super Admin
SUPER_ADMIN_PHONE=+8801000000000

# -----------------------------
# CORS
# -----------------------------
# FRONTEND_URL should be a single origin (no trailing slash), e.g. https://app.example.com
FRONTEND_URL=http://localhost:8080
# ALLOWED_ORIGINS supports comma-separated origins
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
# Never set true in production
ALLOW_ALL_ORIGINS=false

# -----------------------------
# Seeding (opt-in only)
# -----------------------------
SEED_ON_STARTUP=false
FORCE_SEED_RESET=false
# Legacy aliases (supported, keep false in production)
AUTO_SEED_TEST_DATA=false
AUTO_SEED_RESET_DATA=false
SEED_TEST_PASSWORD=TestPass123!

# -----------------------------
# Email (optional)
# -----------------------------
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=no-reply@example.com
EMAIL_PASS=replace_with_email_password
# Legacy alias accepted by backend if EMAIL_PASS is missing
# EMAIL_PASSWORD=replace_with_email_password
EMAIL_FROM=Smart Campus <no-reply@example.com>

# -----------------------------
# Storage (optional)
# -----------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# -----------------------------
# AI / External Services (optional)
# -----------------------------
OPENAI_API_KEY=
HUGGINGFACE_API_KEY=
AI_SERVICE_URL=

# -----------------------------
# SMS (optional)
# -----------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# -----------------------------
# Feature Flags (optional)
# -----------------------------
REQUIRE_EMAIL_VERIFICATION=false
SEND_ABSENT_SMS=false
SEND_PAYMENT_RECEIPT=true
ENABLE_AI_FEATURES=true
ENABLE_REAL_TIME_NOTIFICATIONS=true
