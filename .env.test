# Smart Campus Backend - Test/Local env sample

NODE_ENV=test
PORT=5000

MONGO_URI=mongodb://127.0.0.1:27017/smartcampus_test
USE_MEMORY_DB=false
USE_MOCK_DB=false

JWT_SECRET=test_jwt_secret_minimum_32_characters_required
JWT_REFRESH_SECRET=test_refresh_secret_minimum_32_chars
JWT_EXPIRE=7d
JWT_REFRESH_EXPIRE=30d

SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=SecurePassword123!
SUPER_ADMIN_NAME=Super Administrator
SUPER_ADMIN_PHONE=+1234567890

FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
ALLOW_ALL_ORIGINS=false

BCRYPT_ROUNDS=12
SEED_ON_STARTUP=false
FORCE_SEED_RESET=false
